# Configuración de Nginx para AdminCUSC
# Copiar este archivo a /etc/nginx/sites-available/admincusc
# y crear un enlace simbólico en /etc/nginx/sites-enabled/

# Configuración HTTP (sin SSL por ahora)
server {
    listen 80;
    server_name 137.184.188.234 tu-dominio.com www.tu-dominio.com;
    
    # Redirigir todo el tráfico HTTP a HTTPS
    return 301 https://$server_name$request_uri;
}

# Configuración HTTPS (descomentar cuando tengas SSL configurado)
# server {
#     listen 443 ssl http2;
#     server_name 137.184.188.234 tu-dominio.com www.tu-dominio.com;
#
#     # Certificados SSL (usar Let's Encrypt con Certbot)
#     ssl_certificate /etc/letsencrypt/live/tu-dominio.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/tu-dominio.com/privkey.pem;
    
    # Configuración SSL recomendada
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
#     ssl_prefer_server_ciphers on;
#     ssl_session_cache shared:SSL:10m;
#     ssl_session_timeout 10m;
#
#     # ... resto de configuración HTTPS ...
# }

    # Tamaño máximo de archivos subidos
    client_max_body_size 10M;

    # Archivos estáticos y media
    location /static/ {
        alias /var/www/admincusc/backend/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /var/www/admincusc/backend/media/;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Proxy al servidor Django (Gunicorn)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Configuración especial para WebSocket (si es necesario en el futuro)
    # location /ws/ {
    #     proxy_pass http://127.0.0.1:8000;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "upgrade";
    # }

    # Headers de seguridad
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
